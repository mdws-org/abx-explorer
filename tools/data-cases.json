{
  "$comment": "Cases for tools/check-data.test.mjs. Each case changes one field of a known-good file (tools/fixtures/contracts.json or the owner index built in the test) and states whether the schema must accept or reject the result. path is a list of keys and array indexes; op is set or delete.",
  "cases": [
    { "target": "contracts", "expect": "reject", "name": "sale id as a number (the Worker writes decimal strings)", "op": "set", "path": ["contracts", 0, "sale", "sales"], "value": [{ "paymentToken": "0x0000000000000000000000000000000000000000", "price": "0", "allocation": 1, "sold": 0, "id": 0 }] },
    { "target": "contracts", "expect": "accept", "name": "sale id as a decimal string", "op": "set", "path": ["contracts", 0, "sale", "sales"], "value": [{ "paymentToken": "0x0000000000000000000000000000000000000000", "price": "42000000000000000", "allocation": 99, "sold": 99, "id": "0" }] },
    { "target": "contracts", "expect": "reject", "name": "sale id with a sign", "op": "set", "path": ["contracts", 0, "sale", "sales"], "value": [{ "paymentToken": "0x0000000000000000000000000000000000000000", "price": "0", "allocation": 1, "sold": 0, "id": "-1" }] },
    { "target": "contracts", "expect": "accept", "name": "allocation of uint256 max read through Number()", "op": "set", "path": ["contracts", 0, "sale", "sales"], "value": [{ "paymentToken": "0x0000000000000000000000000000000000000000", "price": "0", "allocation": 1.157920892373162e+77, "sold": 4 }] },
    { "target": "contracts", "expect": "reject", "name": "price as a number (wei loses precision)", "op": "set", "path": ["contracts", 0, "sale", "sales"], "value": [{ "paymentToken": "0x0000000000000000000000000000000000000000", "price": 42000000000000000, "allocation": 99, "sold": 0 }] },
    { "target": "contracts", "expect": "reject", "name": "payment token that is not an address", "op": "set", "path": ["contracts", 0, "sale", "sales"], "value": [{ "paymentToken": "ETH", "price": "0", "allocation": 1, "sold": 0 }] },
    { "target": "contracts", "expect": "reject", "name": "chainId as a string", "op": "set", "path": ["contracts", 0, "chainId"], "value": "8453" },
    { "target": "contracts", "expect": "reject", "name": "chain the page has no table entry for", "op": "set", "path": ["contracts", 0, "chainId"], "value": 10 },
    { "target": "contracts", "expect": "reject", "name": "address in mixed case", "op": "set", "path": ["contracts", 0, "address"], "value": "0xAB8D205242A4D31D64A6CD2949FC2ADFB27C5B70" },
    { "target": "contracts", "expect": "reject", "name": "address one character short", "op": "set", "path": ["contracts", 0, "address"], "value": "0xab8d205242a4d31d64a6cd2949fc2adfb27c5b7" },
    { "target": "contracts", "expect": "reject", "name": "unknown kind", "op": "set", "path": ["contracts", 0, "kind"], "value": "Series video" },
    { "target": "contracts", "expect": "reject", "name": "unknown sale state", "op": "set", "path": ["contracts", 0, "sale", "state"], "value": "closed" },
    { "target": "contracts", "expect": "accept", "name": "shared minter with no sale configured", "op": "set", "path": ["contracts", 0, "sale", "state"], "value": "no sale set" },
    { "target": "contracts", "expect": "reject", "name": "missing name", "op": "delete", "path": ["contracts", 0, "name"] },
    { "target": "contracts", "expect": "reject", "name": "missing sale", "op": "delete", "path": ["contracts", 0, "sale"] },
    { "target": "contracts", "expect": "reject", "name": "tx hash too short", "op": "set", "path": ["contracts", 0, "tx"], "value": "0x1234" },
    { "target": "contracts", "expect": "reject", "name": "block with a fraction", "op": "set", "path": ["contracts", 0, "block"], "value": 58802810.5 },
    { "target": "contracts", "expect": "reject", "name": "block as a hex string", "op": "set", "path": ["contracts", 0, "block"], "value": "0x10" },
    { "target": "contracts", "expect": "accept", "name": "description, image and ownerName may be null", "op": "set", "path": ["contracts", 0, "description"], "value": null },
    { "target": "contracts", "expect": "reject", "name": "description as a number", "op": "set", "path": ["contracts", 0, "description"], "value": 7 },
    { "target": "contracts", "expect": "reject", "name": "image copy without its key", "op": "set", "path": ["contracts", 0, "copy"], "value": { "sha256": "00", "bytes": 1, "type": "image/png", "savedAt": 1, "checkedAt": 1 } },
    { "target": "contracts", "expect": "reject", "name": "generated as an ISO string", "op": "set", "path": ["generated"], "value": "2026-11-19T04:45:11Z" },
    { "target": "contracts", "expect": "reject", "name": "failedChains holding a chain id", "op": "set", "path": ["failedChains"], "value": [8453] },
    { "target": "contracts", "expect": "accept", "name": "failedChains holding a chain name", "op": "set", "path": ["failedChains"], "value": ["Base"] },
    { "target": "contracts", "expect": "reject", "name": "contracts as an object", "op": "set", "path": ["contracts"], "value": {} },
    { "target": "contracts", "expect": "accept", "name": "a new field the page does not read yet", "op": "set", "path": ["contracts", 0, "website"], "value": "https://example.org" },

    { "target": "owners", "expect": "reject", "name": "version 2", "op": "set", "path": ["version"], "value": 2 },
    { "target": "owners", "expect": "reject", "name": "generatedAt without a time", "op": "set", "path": ["generatedAt"], "value": "2026-11-17" },
    { "target": "owners", "expect": "reject", "name": "chain id as a string", "op": "set", "path": ["chains"], "value": ["8453"] },
    { "target": "owners", "expect": "reject", "name": "collection without an address", "op": "delete", "path": ["collections", 0, "address"] },
    { "target": "owners", "expect": "reject", "name": "owner wallet in mixed case", "op": "set", "path": ["owners"], "value": { "0xAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": [[0, 1]] } },
    { "target": "owners", "expect": "reject", "name": "holding count of zero", "op": "set", "path": ["owners"], "value": { "0x1111111111111111111111111111111111111111": [[0, 0]] } },
    { "target": "owners", "expect": "reject", "name": "holding pair with three numbers", "op": "set", "path": ["owners"], "value": { "0x1111111111111111111111111111111111111111": [[0, 1, 2]] } },
    { "target": "owners", "expect": "reject", "name": "holding that points past the collections list", "op": "set", "path": ["owners"], "value": { "0x1111111111111111111111111111111111111111": [[99, 1]] } }
  ]
}
