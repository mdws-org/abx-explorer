{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mdws-org/abx-explorer/blob/main/schema/abx-owners.schema.json",
  "title": "abx-owners.json",
  "description": "Which wallets hold live tokens in which ABX collections, version 1. Written by worker/owners.js (buildOwnersIndex) and read by find3r. A holding is [collectionIndex, count]; tools/check-data.mjs also checks that every collectionIndex points into collections, which a schema cannot express.",
  "type": "object",
  "required": ["version", "generatedAt", "source", "chains", "collections", "owners"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "description": "The oldest owner read in the index, so a collection whose reads keep failing ages the whole file.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "source": { "type": "string" },
    "chains": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chainId", "address", "name"],
        "properties": {
          "chainId": { "type": "integer", "minimum": 1 },
          "address": { "$ref": "#/$defs/address" },
          "name": { "type": ["string", "null"] }
        }
      }
    },
    "owners": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/address" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer" },
          "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 1 }]
        }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" }
  }
}
